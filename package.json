{
  "name": "track-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo test",
    "db:migrate": "cd apps/api && pnpm db:migrate",
    "seed": "cd apps/api && pnpm seed",
    "format:check": "prettier --check \"**/*.{ts,tsx,json}\""
  },
  "devDependencies": {
    "gitnexus": "^1.6.6",
    "prettier": "^3.8.1",
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "jwt-decode": "^4.0.0"
  }
}
