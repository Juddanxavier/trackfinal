# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=development
PORT=4000

# App name shown in emails
APP_NAME=GT Express

# Frontend URL for email links
FRONTEND_URL=http://localhost:3000

# ===========================================
# DATABASE
# ===========================================
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/gtexpress

# ===========================================
# AUTHENTICATION
# ===========================================
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here

# JWT expiration times (e.g., 15m, 1h, 7d)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt rounds for password hashing (10-14, higher = slower but more secure)
BCRYPT_ROUNDS=12

# ===========================================
# GOOGLE OAuth (Optional)
# ===========================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ===========================================
# SMTP EMAIL
# ===========================================
# For production, use a reliable SMTP provider (SendGrid, AWS SES, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=GT Express

# Use port 465 for secure=true, or 587 for STARTTLS
# Example for Gmail/Workplace:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ===========================================
# REDIS (for BullMQ job queue)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ===========================================
# SENTRY (Error Tracking)
# ===========================================
# Get DSN from https://sentry.io
SENTRY_DSN=https://your-dsn@sentry.io/project

# ===========================================
# TRACKING PROVIDERS
# ===========================================
# 17Track API
TRACK17_API_KEY=your-17track-api-key

# TrackCourier.io (for India-focused tracking)
TRACKCOURIER_API_KEY=your-trackcourier-api-key

# Active provider: 17track or trackcourier
TRACKING_PROVIDER=17track

# ===========================================
# NOTIFICATIONS
# ===========================================
# Notification retention
NOTIFICATION_EXPIRY_DAYS=30

# WhatsApp via MSG91 (optional)
MSG91_API_KEY=your-msg91-api-key
MSG91_WHATSAPP_SENDER=91xxxxxxxxxx

# Enable/disable notification channels
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_WHATSAPP_ENABLED=false
NOTIFICATION_INAPP_ENABLED=true
NOTIFICATION_USE_QUEUE=true

# ===========================================
# CORS
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# ===========================================
# RATE LIMITING
# ===========================================
# Requests per minute allowed per IP
THROTTLE_LIMIT=100
THROTTLE_TTL=60

# ===========================================
# SESSION CLEANUP
# ===========================================
# Cron schedule for cleaning expired sessions (default: weekly Sunday at midnight)
SESSION_CLEANUP_CRON=0 0 * * 0

# Shipment archival schedule (default: daily at midnight)
SHIPMENT_CLEANUP_CRON=0 0 * * *