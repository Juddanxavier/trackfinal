# ===========================
# Required Environment Variables
# ===========================

# ===========================
# Server
# ===========================
NODE_ENV=production
PORT=4000

# ===========================
# Database (PostgreSQL)
# ===========================
DATABASE_URL=postgresql://postgres:password@10.0.97.229:5432/gtexpress?sslmode=disable

# ===========================
# Redis
# ===========================
REDIS_HOST=10.0.97.229
REDIS_PORT=6379

# ===========================
# Authentication
# ===========================
JWT_SECRET=your-64-character-jwt-secret-here-generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=your-64-character-refresh-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ===========================
# Frontend URL (for CORS)
# ===========================
FRONTEND_URL=https://admin.gajantraders.com
CORS_ORIGIN=https://admin.gajantraders.com,https://api.gajantraders.com

# ===========================
# SMTP (Email) - Optional
# ===========================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=GT Express

# ===========================
# Sentry (Error Tracking) - Optional
# ===========================
# SENTRY_DSN=

# ===========================
# Tracking Provider - Optional
# ===========================
TRACKING_PROVIDER=17track
# TRACK17_API_KEY=

# ===========================
# Notifications - Optional
# ===========================
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_WHATSAPP_ENABLED=false
NOTIFICATION_INAPP_ENABLED=true
NOTIFICATION_USE_QUEUE=true
NOTIFICATION_EXPIRY_DAYS=30

# ===========================
# Throttling
# ===========================
THROTTLE_TTL=60
THROTTLE_LIMIT=100